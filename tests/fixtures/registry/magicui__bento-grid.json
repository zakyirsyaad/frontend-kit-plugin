        "content": "import { ArrowRightIcon } from \"@radix-ui/react-icons\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { cn } from \"@/lib/utils\"\n\nexport function BentoCard({ name, description, href, className }: { name: string; description: string; href: string; className?: string }) {\n  return (\n    <div className={cn(\"group relative flex flex-col justify-end overflow-hidden rounded-xl bg-white dark:bg-black\", className)}>\n      <h3 className=\"text-xl font-semibold text-neutral-700 dark:text-neutral-300\">{name}</h3>\n      <p className=\"max-w-lg text-neutral-400\">{description}</p>\n      <Button variant=\"ghost\" asChild size=\"sm\" className=\"border-border\">\n        <a href={href}>\n          Learn more\n          <ArrowRightIcon className=\"ms-2 size-4\" />\n        </a>\n      </Button>\n      <div className=\"pointer-events-none absolute inset-0 group-hover:bg-black/[.03] group-hover:dark:bg-neutral-800/10\" />\n    </div>\n  )\n}\n"
